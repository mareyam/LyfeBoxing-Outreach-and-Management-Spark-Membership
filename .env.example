# Google service account with Editor access to the Spark Memberships sheet.
# Share the sheet with the service account's client_email as Editor, then
# set these as environment variables on Vercel (and in .env.local for
# local dev — that file is gitignored, never commit real credentials).

GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_CLIENT_EMAIL=
# Paste the private_key from the service account JSON, keeping \n escapes.
GOOGLE_SHEETS_PRIVATE_KEY=

# Grok webhook — this app never sends email/SMS itself. It flips a sheet
# row to "Queued" and POSTs { tab, rows, kind, site, queuedAt } here.
# GROK_WEBHOOK_AUTH is the full Authorization header value (e.g. "Bearer xyz").
GROK_WEBHOOK_URL=
GROK_WEBHOOK_AUTH=

# Lets "Generate with AI" and the lead sequence draft emails. Leave unset
# and those buttons explain that drafting isn't configured yet.
ANTHROPIC_API_KEY=

# Link inserted into every lead follow-up draft. When empty, drafts use the
# Trial link saved on the Playbook page.
TRIAL_BOOKING_URL=

# Vercel Cron sends this as Authorization: Bearer <CRON_SECRET> to
# /api/cron/lead-sequence every 3 hours. The route rejects calls without it.
CRON_SECRET=

# Set to true to let the cron queue day-1 drafts and notify Grok.
# Leave unset (or anything other than true/1) and the cron only writes Drafts.
AUTO_SEND_STEP1=

# Shared password for the login form. A correct password sets an HttpOnly
# cookie that unlocks every page and /api route. Leave unset to keep the
# site open (local dev, or before the password is chosen).
SITE_PASSWORD=
