# Google service account with Editor access to the Spark Memberships sheet.
# Share the sheet with the service account's client_email as Editor, then
# set these as environment variables on Vercel (and in .env.local for
# local dev — that file is gitignored, never commit real credentials).

GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_CLIENT_EMAIL=
# Paste the private_key from the service account JSON, keeping \n escapes.
GOOGLE_SHEETS_PRIVATE_KEY=

# Grok webhook — this app never sends email/SMS itself. It flips a sheet
# row to "Queued" and pings this webhook; Grok is what actually sends.
GROK_WEBHOOK_URL=
# The full Authorization header value Grok's webhook expects (e.g. "Bearer xyz").
GROK_WEBHOOK_AUTH=

# Lets the "Generate with AI" button on New Campaign draft a subject/body
# from a rough one-line idea. Leave unset and the button just explains it's
# not configured yet.
ANTHROPIC_API_KEY=

# Puts the whole site (and every /api route) behind a single shared
# password via HTTP Basic Auth. Leave unset during local dev; set this on
# Vercel before anyone besides you has the URL.
SITE_PASSWORD=
